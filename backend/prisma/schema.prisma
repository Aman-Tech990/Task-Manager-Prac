generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  tasks    Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Task {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  userId      Int

  user User @relation(fields: [userId], references: [id])
}
